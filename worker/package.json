{
  "name": "scrape-monitor-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:scheduled": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ../test",
    "db:migrate:local": "wrangler d1 migrations apply scrape-monitor --local",
    "db:migrate:remote": "wrangler d1 migrations apply scrape-monitor --remote",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "^5.20261110.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.160.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
